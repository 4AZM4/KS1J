# Copy to apps/web/.env.local and apps/mobile/.env.local. Never commit real values.

# Public values: safe in the app and browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# true = seeded demo accounts, mock payments, cached helpdesk answers
NEXT_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_MODE=true

# Where members' documents are stored: supabase (default) or firebase. See docs/firebase-storage.md.
# The Firebase web config is public (it identifies the project; the storage rules protect the files).
NEXT_PUBLIC_FILE_STORAGE=supabase
EXPO_PUBLIC_FILE_STORAGE=supabase
NEXT_PUBLIC_FIREBASE_CONFIG=
EXPO_PUBLIC_FIREBASE_CONFIG=

# Server-only (apps/web API routes or Supabase Edge Functions). Never prefix with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Supabase Edge Function secrets for Firebase file storage (set in Supabase, never here):
# FIREBASE_SERVICE_ACCOUNT  (the whole service account JSON), optional FIREBASE_STORAGE_BUCKET
